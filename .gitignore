# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (SECRETS — Supabase & Stripe keys. Never commit these.)
.env
.env.*
# ...but DO commit the template that documents which keys are needed.
!.env.example
# Signing material and Firebase service accounts never go in the repo.
*.keystore
google-services.json
firebase-service-account*.json
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# ==========================================================================
# Project docs policy:
# Only CLAUDE.md is shared (so every developer stays on the same page).
# Every other .md (AGENTS.md, the roadmap, notes, READMEs) stays local.
# ==========================================================================
*.md
!CLAUDE.md

# Claude local/personal working files (roadmap, design inspiration, etc.)
.claude/*.local.*
.claude/inspiration.local/

# Release keystore & Firebase service account
android/app/release.keystore
shopecircle-9d8d1-firebase-adminsdk-*.json

# Copy to .env and fill in. Restart the bundler after editing — Expo reads
# these at bundler start, not per reload.
#
# EXPO_PUBLIC_* variables are INLINED INTO THE APP BUNDLE at build time. Anyone
# can extract them from the APK. That's fine for these two — the Supabase anon
# key is gated by Row Level Security, and the Algolia key is search-only — but
# never put a service-role or admin key behind this prefix.
#
# The same values must exist as GitHub Actions secrets for CI to build.

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Algolia — Settings → API Keys. Use the SEARCH-ONLY key, never the Admin key.
EXPO_PUBLIC_ALGOLIA_APP_ID=
EXPO_PUBLIC_ALGOLIA_SEARCH_KEY=

# Index names from the Supabase → Algolia connector. Leave an index blank and
# that tab falls back to Postgres `ilike` search automatically.
EXPO_PUBLIC_ALGOLIA_PRODUCTS_INDEX=
EXPO_PUBLIC_ALGOLIA_POSTS_INDEX=
EXPO_PUBLIC_ALGOLIA_PROFILES_INDEX=
